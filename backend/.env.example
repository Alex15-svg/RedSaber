# Copia este archivo con el nombre .env y completa tus datos.
# El archivo .env no se sube a GitHub.

# Conexión a PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_contrasena
PGDATABASE=redsaber_db

# Clave para firmar y verificar los tokens de sesión (usa un texto largo y secreto)
JWT_SECRET=cambia_esta_clave_por_una_larga

# Moderación (RF-12): reportes para deshabilitar y días de plazo para apelar
MODERACION_UMBRAL=3
PLAZO_APELACION_DIAS=7
